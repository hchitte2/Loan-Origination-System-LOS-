{
  "name": "clearline",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check": "biome check . && pnpm typecheck && pnpm test",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:db": "vitest run --project db --passWithNoTests",
    "e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/cli.ts migrate",
    "db:seed": "tsx src/db/cli.ts seed",
    "db:reset": "tsx src/db/cli.ts reset",
    "seed:files": "tsx src/db/cli.ts seed-files",
    "db:migrate:prod": "tsx src/db/cli.ts migrate --env .env.production.local",
    "db:seed:prod": "tsx src/db/cli.ts seed --env .env.production.local"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@neondatabase/serverless": "1.1.0",
    "@vercel/blob": "2.8.0",
    "better-auth": "1.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "next-themes": "0.4.6",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "^4.21.0",
    "sonner": "^2.0.8",
    "tw-animate-css": "^1.4.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.12",
    "@electric-sql/pglite": "0.5.8",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5.9.3",
    "vitest": "4.1.11"
  },
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": "22.x"
  }
}
