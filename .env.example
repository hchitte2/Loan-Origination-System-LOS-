# Clearline environment. Copy to .env.local for local development; .env.local is gitignored.
# Local development points DATABASE_URL at the Neon `dev` branch; Vercel holds the `main` values.
# No secret is ever NEXT_PUBLIC_.

# Neon Postgres connection string (dev branch locally).
DATABASE_URL=postgresql://user:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob private store (Vercel → Storage → the store → ".env.local" tab).
BLOB_READ_WRITE_TOKEN=

# Bearer token the Vercel cron sends to /api/cron/reset. Generate with: openssl rand -hex 16
CRON_SECRET=

# Password shared by every seeded demo account. Nobody types it; the login cards use it.
DEMO_PASSWORD=

# Fixed upload token of the showcase loan, linked from the login page. Generate with: openssl rand -hex 16
DEMO_SHOWCASE_TOKEN=
